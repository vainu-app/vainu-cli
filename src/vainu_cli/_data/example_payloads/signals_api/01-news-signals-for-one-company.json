{
  "_meta": {
    "recipe": "News signals for one company",
    "source_url": "https://developers.vainu.com/v3/docs/signals-api",
    "endpoint": "POST https://api.vainu.io/api/v3/signals/news/",
    "note": "business_ids must be country-prefixed and only supports ?IN. Relative dates need plural units: '1 years ago' works, '1 year ago' returns 400."
  },
  "query": {
    "?ALL": [
      { "?IN": { "business_ids": ["FI25578642"] } },
      { "?GTE": { "vainu_date": "1 years ago" } }
    ]
  },
  "limit": 20
}
